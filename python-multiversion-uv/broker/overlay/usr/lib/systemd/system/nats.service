[Unit]
Description=NATS message broker for fleet coordination
After=network-online.target
Wants=network-online.target
Before=app311.service app312.service app314.service

[Service]
Type=simple
ExecStart=/usr/local/bin/nats-server -a 127.0.0.1 -p 4222
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
