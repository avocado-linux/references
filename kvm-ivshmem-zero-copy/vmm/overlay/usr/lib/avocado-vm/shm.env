# The one shared-memory region, sourced by every VM launch.
#
# Both qemu processes must agree on the path AND the size. They are set here,
# in the platform extension, rather than in each VM's own env file precisely
# so the two cannot drift: a size mismatch does not error, it just gives the
# second VM a different mapping and the demo hangs waiting for a peer that
# will never appear.
#
# The file is created and sized by whichever qemu starts first
# (memory-backend-file ftruncates it), so nothing needs to pre-create it.
SHM_PATH=/dev/shm/avocado-ivshmem
SHM_SIZE=64M
