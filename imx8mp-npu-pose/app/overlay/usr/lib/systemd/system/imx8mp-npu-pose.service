[Unit]
Description=i.MX8MP NPU MoveNet single-person pose estimation (NNStreamer + VX delegate)
After=weston.service
Wants=weston.service
ConditionPathExists=/dev/video0

[Service]
Type=simple
# waylandsink connects to the weston compositor's socket (display mode).
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=WAYLAND_DISPLAY=wayland-1
# Flip to USE_NPU=0 to run the identical model on the CPU and compare fps.
Environment=USE_NPU=1
# Browser skeleton preview (MJPEG) at http://<board>:8080/ -- works headless.
# Set WEB_PORT=0 to disable.
Environment=WEB_PORT=8080
#Environment=USE_DISPLAY=auto
#Environment=CAMERA_DEVICE=auto
#Environment=PREVIEW_SIZE=480
#Environment=SCORE_THRESH=0.3
ExecStart=/usr/bin/python3 /usr/local/bin/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
