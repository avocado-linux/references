<?xml version="1.0"?>
<!--
  URDF for the UFactory Lite 6 robotic arm.

  Joint origins, axes, and frame orientations are taken from the official
  xarm_ros2 xacro (xarm_description/urdf/lite6/lite6.urdf.xacro).

  All six revolute joints rotate around their local Z axis, with RPY
  offsets on the joint origins to align frames per the DH convention.
  This means joint angle = 0 matches the real arm's home (folded) pose.

  Visual geometry uses simple shapes for lightweight rendering in
  Foxglove / RViz — replace with official mesh files for production.
-->
<robot name="lite6">

  <!-- ===== world → base ===== -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== base_link ===== -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
  </link>

  <!-- ===== Joint 1: base rotation ===== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2435" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="50" velocity="3.14"/>
  </joint>
  <link name="link1">
    <visual>
      <geometry><cylinder radius="0.045" length="0.12"/></geometry>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
    </visual>
  </link>

  <!-- ===== Joint 2: shoulder ===== -->
  <!-- RPY rotates the frame so joint2's Z axis points along the real
       shoulder pivot direction. At angle=0 the upper arm folds back. -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.5708 -1.5708 3.1416"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.059" upper="2.094" effort="50" velocity="3.14"/>
  </joint>
  <link name="link2">
    <visual>
      <geometry><box size="0.2002 0.038 0.038"/></geometry>
      <origin xyz="0.1001 0 0" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- ===== Joint 3: elbow ===== -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.2002 0 0" rpy="-3.1416 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.927" upper="0.192" effort="32" velocity="3.14"/>
  </joint>
  <link name="link3">
    <visual>
      <geometry><cylinder radius="0.035" length="0.087"/></geometry>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0"/>
      <material name="light_grey"><color rgba="0.85 0.85 0.85 1"/></material>
    </visual>
  </link>

  <!-- ===== Joint 4: wrist rotation ===== -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.087 -0.22761 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="32" velocity="3.14"/>
  </joint>
  <link name="link4">
    <visual>
      <geometry><box size="0.032 0.032 0.12"/></geometry>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- ===== Joint 5: wrist bend ===== -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.692" upper="3.14159" effort="32" velocity="3.14"/>
  </joint>
  <link name="link5">
    <visual>
      <geometry><cylinder radius="0.028" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="light_grey"><color rgba="0.85 0.85 0.85 1"/></material>
    </visual>
  </link>

  <!-- ===== Joint 6: flange rotation ===== -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.0625 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="20" velocity="3.14"/>
  </joint>
  <link name="link6">
    <visual>
      <geometry><cylinder radius="0.024" length="0.035"/></geometry>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <material name="accent"><color rgba="0.15 0.65 0.6 1"/></material>
    </visual>
  </link>

</robot>
