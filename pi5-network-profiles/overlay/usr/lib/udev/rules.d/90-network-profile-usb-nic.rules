# Mark a USB Ethernet adapter so a networkd file can match it without naming its interface.
# The kernel names such an adapter eth1, enx<mac> or usb0 depending on the adapter and the
# naming policy, and the same kernel drivers (cdc_ether, cdc_ncm, rndis_host) also drive
# cellular modems that present as Ethernet. The rule therefore matches by where the link
# comes from, USB, and takes known modems out by USB vendor, not by driver or name.
#
# AVOCADO_USB_NIC=1 is read by 10-np-usb-ethernet.network, generated by network-profile.

SUBSYSTEM!="net", GOTO="np_end"
ACTION!="add|change", GOTO="np_end"
ATTR{type}!="1", GOTO="np_end"
SUBSYSTEMS!="usb", GOTO="np_end"

ENV{AVOCADO_USB_NIC}="1"

# USB vendors whose Ethernet-type links are cellular modems, not internet adapters.
#   3838  Eagle (I425-GL)
#   2c7c  Quectel (EG25, RG255)
#   1bc7  Telit
#   1199  Sierra Wireless
#   05c6  Qualcomm reference designs, used by several modem makers
#   12d1  Huawei
#   19d2  ZTE
#   1e0e  Simcom
ATTRS{idVendor}=="3838|2c7c|1bc7|1199|05c6|12d1|19d2|1e0e", ENV{AVOCADO_USB_NIC}="0"

LABEL="np_end"
