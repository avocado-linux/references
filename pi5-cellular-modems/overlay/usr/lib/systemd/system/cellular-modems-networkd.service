[Unit]
Description=Reload networkd so it sees the cellular modem network profile
# networkd starts before the extension merge, so on a cold boot it has not read
# this extension's 30-cellular.network. Until it does, a modem link named usb0
# matches the stock 80-wired.network and gets Ethernet's route metric. This unit
# exists only after the merge, which makes it the first point that can ask
# networkd to re-read its configuration.
After=systemd-networkd.service
Wants=systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/networkctl reload

[Install]
WantedBy=multi-user.target
