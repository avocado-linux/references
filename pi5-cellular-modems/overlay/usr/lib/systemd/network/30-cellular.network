# The link a USB modem creates: usbN for an ECM/NCM/RNDIS modem, wwanN for a
# QMI or MBIM one. Predictable interface names are off in Avocado, so the
# kernel's names apply, and the number is not always 0: a second modem, a modem
# with two data interfaces, or one that resets and re-enumerates before its old
# link is gone all come up as usb1 or wwan1. The number sorts this file ahead of
# the stock 80-wired.network, which matches every Ethernet-type link and would
# otherwise give a modem the same low route metric as Ethernet.
[Match]
Name=usb* wwan*

[Network]
DHCP=ipv4

[DHCPv4]
# Behind Ethernet (10) and Wi-Fi (200), so the modem carries traffic only when
# the others have no route.
RouteMetric=300
