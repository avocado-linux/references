[Unit]
Description=x86 RTX GPU Inference Dashboard
# No network-online dependency on purpose: the server binds 0.0.0.0 (works before
# any link is up) and makes no outbound calls at start. Pulling network-online in
# would activate systemd-networkd-wait-online, which on this 6-NIC box blocks boot
# until unplugged ports time out (~120s). Let the dashboard come up immediately;
# connections are simply accepted once the network is up.

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/app/packages
ExecStart=/usr/bin/python3 /usr/local/bin/app.py
Restart=on-failure
RestartSec=5

# Override the HTTP port or point at your own model.
#Environment=APP_PORT=8080
#Environment=APP_MODEL=/usr/lib/app/models/model.onnx

[Install]
WantedBy=multi-user.target
